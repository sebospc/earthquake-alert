    "LATE_ALERT_BODY": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The earthquake happened %@ min ago. This is no longer an early warning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sismo ocurrió hace %@ min. Ya no es un aviso anticipado."
          }
        },
