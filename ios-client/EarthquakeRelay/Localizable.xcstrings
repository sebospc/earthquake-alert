    },
    "La usamos para elegir los sensores cercanos. Su posición exacta no sale del teléfono.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "We use it to choose nearby sensors. Your exact position never leaves the phone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nós a usamos para escolher os sensores próximos. Sua posição exata não sai do telefone."
          }
        }
      }
    },
    "Las alertas pueden no sonar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alerts May Not Sound"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os alertas podem não tocar"
          }
        }
      }
    },
    "Le avisamos cuando se detecta un sismo cerca de usted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "We alert you when an earthquake is detected near you."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avisamos você quando um terremoto é detectado perto de você."
          }
        }
      }
    },
    "Le enviamos una alerta de prueba para que escuche cómo suena.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "We send you a test alert so you can hear how it sounds."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enviamos um alerta de teste para você ouvir como ele soa."
          }
        }
      }
    },
    "Llegó. Así sonará una alerta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "It arrived. This is how an alert will sound."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chegou. É assim que um alerta vai tocar."
