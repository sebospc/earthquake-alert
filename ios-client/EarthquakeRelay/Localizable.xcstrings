    "LATE_ALERT_BODY": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El sismo ocurrió hace %@ min. Ya no es un aviso anticipado."
          }
        },
        "es": {
