    "Cobertura limitada: solo le avisaremos de sismos fuertes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Limited coverage: we'll only alert you about strong earthquakes."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobertura limitada: solo le avisaremos de sismos fuertes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cobertura limitada: só avisaremos sobre terremotos fortes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sınırlı kapsama: yalnızca güçlü depremlerde sizi uyarırız."
          }
        }
      }
    },
    "Cobertura parcial: algunos sismos pequeños podrían no avisarse.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Partial coverage: some small earthquakes may not trigger an alert."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobertura parcial: algunos sismos pequeños podrían no avisarse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cobertura parcial: alguns terremotos pequenos podem não ser avisados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kısmi kapsama: bazı küçük depremler için uyarı gelmeyebilir."
          }
        }
      }
    },
    "Con Concentración activa, el aviso puede llegar en silencio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "With a Focus on, the alert may arrive silently."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Concentración activa, el aviso puede llegar en silencio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Com um Foco ativado, o aviso pode chegar em silêncio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir Odak açıkken uyarı sessiz gelebilir."
          }
        }
      }
    },
