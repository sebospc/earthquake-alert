    "La usamos para elegir los sensores cercanos. Su posición exacta no sale del teléfono.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "We use it to choose nearby sensors. Your exact position never leaves the phone."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "La usamos para elegir los sensores cercanos. Su posición exacta no sale del teléfono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nós a usamos para escolher os sensores próximos. Sua posição exata não sai do telefone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yakındaki sensörleri seçmek için kullanırız. Tam konumunuz telefondan çıkmaz."
          }
        }
      }
    },
