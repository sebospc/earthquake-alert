    "Cobertura limitada: solo le avisaremos de sismos fuertes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Limited coverage: we'll only alert you about strong earthquakes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cobertura limitada: só avisaremos sobre terremotos fortes."
          }
        }
      }
    },
    "Cobertura parcial: algunos sismos pequeños podrían no avisarse.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Partial coverage: some small earthquakes may not trigger an alert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cobertura parcial: alguns terremotos pequenos podem não ser avisados."
          }
        }
      }
    },
    "Con Concentración activa, el aviso puede llegar en silencio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "With a Focus on, the alert may arrive silently."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Com um Foco ativado, o aviso pode chegar em silêncio."
          }
        }
      }
    },
    "Dejará de recibir alertas de sismo y borraremos su registro del servidor.": {
      "shouldTranslate": false
    },
    "Enviada. Debería sonar en unos segundos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sent. It should sound in a few seconds."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enviado. Deve tocar em alguns segundos."
          }
        }
      }
    },
