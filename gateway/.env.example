PORT=8787
RELAY_HMAC_SECRET=replace-with-at-least-32-random-bytes
# 1 stops all forwarding (APNs and web push). Heartbeats and /status keep working.
RELAY_KILL_SWITCH=0

# Use dry-run until rights, source validation and Apple setup are resolved.
APNS_DRY_RUN=1
APNS_TEAM_ID=YOUR_TEAM_ID
APNS_KEY_ID=YOUR_KEY_ID
APNS_BUNDLE_ID=com.example.earthquakerelay

# For real APNs only, one of the two. The file is simpler: a path to the .p8 from Apple.
APNS_PRIVATE_KEY_FILE=
# APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
EVIDENCE_FILE=gateway-evidence.jsonl
# Arrivals uploaded by opted-in test iPhones (POST /telemetry/arrivals).
TELEMETRY_FILE=telemetry.jsonl
# Key of the certifier (monitor/) for /probe, /evidence and monitor subscriptions.
# Leave empty to disable them. Generate with: openssl rand -hex 32
MONITOR_KEY=
SUBSCRIPTIONS_FILE=subscriptions.json
# iOS app device tokens and the sensors each one follows.
DEVICES_FILE=devices.json
# Which sensors were announced to their subscribers as without coverage.
COVERAGE_STATE_FILE=coverage-state.json
# Last heartbeat and aea_ok per sensor, so a restart does not turn every sensor red.
HEARTBEATS_FILE=heartbeats.json

# Web push for the PWA. Leave VAPID_PUBLIC_KEY empty to disable it.
# Generate once with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
